# Copy to .env for local development. Never commit real values.
# Owner role: runs migrations only (spec §3.1: service key limited to migrations and audited system jobs).
DATABASE_URL_OWNER=postgres://app_owner:app_owner_dev@localhost:54329/gym
# API login role: has NO table privileges of its own; it switches to app_authenticated per transaction.
DATABASE_URL_API=postgres://app_api:app_api_dev@localhost:54329/gym
# HS256 secret shared with the identity provider (Supabase Auth compatible). Dev only.
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars-long
JWT_ISSUER=gym-saas-dev
JWT_AUDIENCE=gym-saas-api
# Stripe: TEST mode only in this repository (sk_test_...). Live keys are rejected at startup.
STRIPE_SECRET_KEY=
