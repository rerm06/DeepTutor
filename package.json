{
  "name": "gym-saas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @gym/db migrate",
    "db:seed": "pnpm --filter @gym/db seed",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.6.3"
  }
}
