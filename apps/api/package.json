{
  "name": "@gym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "copilot:doc": "tsx scripts/copilot-doc.ts"
  },
  "dependencies": {
    "@gym/db": "workspace:*",
    "@gym/shared": "workspace:*",
    "fastify": "5.1.0",
    "jose": "5.9.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "pg": "8.13.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  }
}
